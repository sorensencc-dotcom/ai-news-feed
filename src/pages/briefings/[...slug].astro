---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const briefings = await getCollection('briefings');
  return briefings.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, date, confidenceScore, sourcesEvaluated, themes, summary } = entry.data;

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout title={`${title} | AI Intelligence Radar`} description={summary}>
  <div class="briefing-header">
    <a href="/" class="back-link">← All Briefings</a>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <h1>{title}</h1>

    <div class="metadata-bar">
      <div class="meta-item">
        <span class="meta-label">Consensus confidence</span>
        <span class="meta-value">{Math.round(confidenceScore * 100)}%</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Primary sources</span>
        <span class="meta-value">{sourcesEvaluated} verified</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Synthesis status</span>
        <span class="meta-value status-live">Automated & Corroborated</span>
      </div>
    </div>
  </div>

  <section class="themes-section">
    <h2>Synthesized Themes & 7-Day Velocity</h2>
    <div class="themes-grid">
      {themes.map((theme) => (
        <div class="theme-card">
          <div class="theme-top">
            <h3>{theme.name}</h3>
            <span class={`velocity-badge ${theme.delta7d}`}>
              {theme.delta7d === 'accelerating' ? '▲ 7d Accelerating' : theme.delta7d === 'decelerating' ? '▼ 7d Decelerating' : '● 7d Stable'}
            </span>
          </div>

          <p class="theme-desc">{theme.summary}</p>

          <div class="action-tags">
            {theme.tags.map((tag) => (
              <span class={`action-tag tag-${tag.toLowerCase()}`}>
                [{tag}]
              </span>
            ))}
          </div>

          {theme.primarySources && theme.primarySources.length > 0 && (
            <div class="sources-box">
              <span class="sources-title">Primary corroborations:</span>
              <ul>
                {theme.primarySources.map((source) => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      {source.title} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <article class="prose-content">
    <Content />
  </article>
</Layout>

<style>
  .back-link {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .briefing-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  time {
    display: block;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .metadata-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .status-live {
    color: #3fb950;
  }

  .themes-section {
    margin-bottom: 2.5rem;
  }

  .themes-section h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .themes-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .theme-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .theme-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .theme-top h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .velocity-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-subtle);
  }

  .velocity-badge.accelerating {
    color: #79c0ff;
    border-color: #388bfd66;
  }

  .velocity-badge.decelerating {
    color: #ff7b72;
    border-color: #f8514966;
  }

  .velocity-badge.stable {
    color: var(--text-muted);
  }

  .theme-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .action-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .action-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tag-research {
    color: var(--tag-research-text);
  }

  .tag-evaluate {
    color: var(--tag-eval-text);
  }

  .tag-monitor {
    color: var(--tag-monitor-text);
  }

  .tag-deploy {
    color: #a371f7;
  }

  .sources-box {
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }

  .sources-title {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
  }

  .sources-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sources-box a {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
  }

  .sources-box a:hover {
    text-decoration: underline;
  }

  .prose-content {
    line-height: 1.7;
    color: var(--text-primary);
  }

  .prose-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.4rem;
  }

  .prose-content :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose-content :global(p) {
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .prose-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose-content :global(strong) {
    color: var(--text-primary);
  }
</style>
